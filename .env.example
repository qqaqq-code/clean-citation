# No external LLM credential is used.
# Optional: required only for IEEE-only official routes.
IEEE_XPLORE_API_KEY=

# Optional: required for Springer Nature title search.
SPRINGER_NATURE_API_KEY=

# Optional: required for Elsevier/ScienceDirect title search.
ELSEVIER_API_KEY=

# Optional short-lived (maximum 7 days) OpenReview login token. Public reads
# normally need no account; configure this only when anonymous API calls return
# ChallengeRequiredError. Generate it with --configure-openreview; do not copy
# browser cookies into this file.
OPENREVIEW_ACCESS_TOKEN=

# Public arXiv reads need no key.
# Crossref is deliberately disabled.
